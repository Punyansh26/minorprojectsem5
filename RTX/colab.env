# colab.env  --  keys & settings for run_all.py on Colab.
#
# HOW TO USE:
#   1. Fill in any keys you have (all are OPTIONAL -- leave blank to skip).
#   2. Upload this file to the VM as /content/.env :
#        colab upload '/run/media/rtx/Files/Study/Semester 5/Minor/RTX/colab.env' /content/.env
#   3. Run the orchestrator:
#        colab exec -s minor -f '/run/media/rtx/Files/Study/Semester 5/Minor/RTX/run_all.py'
#
# SECURITY: never commit real tokens. This file is for the VM only.
#           The GitHub token your SESSION_SUMMARY flagged should be rotated.

# --- GitHub (only needed if the repo / a submodule is PRIVATE) ---
# A fine-grained or classic PAT with repo:read. Leave blank for a public clone.
GH_TOKEN=

# --- Cloud reasoning comparison (OPTIONAL) ---
# If set, stage 4 also benchmarks Groq cloud reasoning (openai/gpt-oss-120b path).
GROQ_API_KEY=

# --- Repo / model selection (OPTIONAL -- sensible defaults applied) ---
# Branch to clone. 'main' is public; 'code' may be private per your notes.
REPO_BRANCH=main
# Ollama model tag to pull and benchmark.
MODEL_TAG=qwen3.5:9b

# --- Stage control (OPTIONAL) ---
# Comma list of stages to run. Default runs everything: 1,2,3,4
#   1 = bootstrap (clone/deps/ollama/model)
#   2 = serving config (keep-alive, .env.colab)
#   3 = decode benchmark  -> benchmark_decode_summary.json
#   4 = end-to-end demo2 latency -> demo2_latency_summary.json
# Example to re-run only the benchmarks after a successful bootstrap:
#   STAGES=3,4
# Bootstrap must have run in the current VM before STAGES=3,4 works
# (a restarted kernel keeps /content, but ollama serve may need stage 1 again).

# Timed demo2 turns in stage 4 (default 8 = one pass of the question set;
# 16 = two passes, second pass hits the retrieval cache and is reported separately).
# TURNS=8
STAGES=1,2,3,4
