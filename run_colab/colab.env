# Settings for the Colab VM (uploaded as /content/.env by launch.py). All optional.
# Real keys belong here only -- this file is never zipped into code_bundle.zip.

# Ollama model for reasoning (already benchmarked on the A100).
MODEL_TAG=qwen3.5:9b
OLLAMA_NUM_CTX=16384

# Optional: lets the UI select Groq cloud reasoning instead of local Ollama.
GROQ_API_KEY=

# Speech devices. auto = Whisper on GPU, falling back to CPU if CUDA libs are unusable.
# Set DEMO2_TTS_DEVICE=cuda for faster voice synthesis (only one voice stays cached on GPU).
DEMO2_STT_DEVICE=auto
DEMO2_TTS_DEVICE=cpu
DEMO2_WHISPER_MODEL=small

# Ports on the VM (the public URL always maps to WEB_PORT).
WEB_PORT=3001
API_PORT=8020
