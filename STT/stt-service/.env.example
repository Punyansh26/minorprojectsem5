# Copy this file to .env and adjust as needed. All values shown are the defaults.

STT_SAMPLE_RATE=16000

# Model: tiny.en < base.en < small.en < medium.en < large-v3
# small.en is the sweet spot for CPU laptops. Use large-v3 only if you have a GPU.
STT_MODEL_SIZE=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_FINAL_BEAM_SIZE=5
STT_LANGUAGE=hne

STT_VAD_THRESHOLD=0.5
STT_VAD_MIN_SILENCE_MS=100

STT_EOS_SILENCE_MS=600
STT_MAX_UTTERANCE_MS=20000
STT_PARTIAL_INTERVAL_MS=700
STT_MIN_SPEECH_MS_FOR_PARTIAL=300
STT_PARTIAL_WINDOW_MS=6000

# Domain vocabulary hint — improves recognition of clinic-specific terms/names.
# Customize per deployment (see README "Domain vocabulary").
STT_INITIAL_PROMPT=Appointment booking call. Mentions of dentist, dental cleaning, root canal, filling, checkup, braces, extraction, insurance, morning, afternoon, evening, AM, PM, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday, reschedule, cancel.

STT_HOST=0.0.0.0
STT_PORT=8000
STT_LOG_LEVEL=INFO
STT_ASR_WORKER_THREADS=4

# --- Production hardening (see README "Deploying for a real clinic") ---
# Leave STT_API_KEY blank for local dev only. ALWAYS set it before this is reachable off localhost.
STT_API_KEY=
STT_MAX_CONCURRENT_SESSIONS=8
STT_IDLE_TIMEOUT_S=30

# If you see "keepalive ping timeout" / WinError 64 disconnects on a slower CPU, these are
# already generous — you likely want STT_PARTIAL_INTERVAL_MS raised instead (see above), or
# a smaller model (STT_MODEL_SIZE=base.en or tiny.en).
STT_WS_PING_INTERVAL_S=20
STT_WS_PING_TIMEOUT_S=60
