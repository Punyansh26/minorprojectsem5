# By default, source projects are siblings of demo2. Override only if relocated.
# DEMO2_CODE_ROOT=/absolute/path/to/code
# GROQ_API_KEY=your-key
# Existing institute-assistant/.env supplies Groq configuration if not set here.
DEMO2_STT_DEVICE=auto
DEMO2_WHISPER_MODEL=small
DEMO2_TTS_DEVICE=cpu
DEMO2_SPEECH_THREADS=4
# MMS is used only for the experimental Chhattisgarhi recording option.
DEMO2_STT_LANGUAGE=hne
# DEMO2_DATA_DIR=/absolute/path/to/demo2/data
