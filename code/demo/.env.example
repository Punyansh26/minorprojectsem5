GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# JSON state file, independent of any old SQLite file.
# DEMO_STATE_PATH=/absolute/path/to/shop.json
# Local STT settings are loaded from ../STT/stt-service/.env.
# STT_LANGUAGE=hne
# GPU inference with reduced-precision MMS weights.
DEMO_STT_DEVICE=cuda
DEMO_STT_DTYPE=float16
# Local checkpoint in ../TTS/chattisgarhi-tts-models; Female or Male.
DEMO_TTS_VOICE=Female
DEMO_TTS_DEVICE=cpu
DEMO_TTS_LENGTH_SCALE=1.0
DEMO_SPEECH_THREADS=4
