# Local reasoning is the default; Groq is selected explicitly, never automatically.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=120
# Model residency between turns. Default 5m; on a dedicated kiosk set -1 (never unload)
# to eliminate the ~8 s cold reload between users. Costs VRAM while idle; fine on a
# single-purpose box, wasteful if the GPU is shared. See FutureWork chapter 05 §D.
OLLAMA_KEEP_ALIVE=5m
# Local decode budget (num_predict). Answers are 1-3 short sentences + <=8 quotes, so 512
# bounds the p95 tail; truncation fails safe to "unavailable". Must be <= LLM_MAX_TOKENS.
OLLAMA_NUM_PREDICT=512
# Matching tokenizer is prepared by institute-assistant/setup_local.py.
# OLLAMA_TOKENIZER_PATH=/absolute/path/to/model-tokenizer.json

KB_DIR=knowledge_base
CHROMA_PERSIST_DIR=chroma_index
CHROMA_COLLECTION_NAME=iiitnr_kb

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=6
RETRIEVAL_FETCH_K=32
RETRIEVAL_MAX_DISTANCE=1.5
MAX_CONTEXT_CHARS=14000
# Previous complete question/answer pairs, independently of retrieved TOP_K documents.
HISTORY_TURNS=10
HISTORY_MAX_CHARS=12000
# Deprecated fallback only when HISTORY_TURNS is absent: pairs = HISTORY_MESSAGES // 2.
# HISTORY_MESSAGES=20
# Exact retrieval + reviewed-draft cache; every answered reply still runs grounding review.
RAG_CACHE_ENABLED=true
RAG_CACHE_DB_PATH=rag_cache.sqlite
RAG_CACHE_TTL_SECONDS=3600
RAG_CACHE_MAX_ENTRIES=2000
RAG_CACHE_MAX_ENTRY_BYTES=131072
RAG_CACHE_TIMEOUT_SECONDS=0.1
MAX_QUESTION_CHARS=2000

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30



OPENJEV_API_KEY="Your Key"




# Keep SDK retries off; the application separately allows one short 429 retry.
LLM_MAX_RETRIES=0
# Retry once only if Groq's Retry-After is within this many seconds (0 disables; max 60).
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=45
LLM_MAX_TOKENS=1600
TIMEZONE=Asia/Kolkata
# Enable only after configuring SMTP and scheduling check_reminders.py.
REMINDERS_ENABLED=false

CHECKPOINT_DB_PATH=agent_memory.sqlite
ESCALATION_LOG_PATH=escalations.json

TICKETS_DB_PATH=tickets.sqlite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=20
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=IIIT-NR Institute Assistant
OFFICE_EMAIL_ADMISSIONS=admissions@iiitnr.example.edu
OFFICE_EMAIL_HOSTEL=hostel@iiitnr.example.edu
OFFICE_EMAIL_CG=cgcounselling@iiitnr.example.edu
OFFICE_EMAIL_ACADEMICS=academics@iiitnr.example.edu
OFFICE_EMAIL_GENERAL=helpdesk@iiitnr.example.edu

# Verified releases override legacy Chroma/model settings when kb_state/active.json exists.
# KB_STATE_DIR defaults to the sibling of the absolute KB_DIR, shared with Demo 2.
# KB_STATE_DIR=/absolute/path/to/institute-assistant/kb_state
KB_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KB_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
KB_CHUNK_TOKENS=350
KB_OVERLAP_TOKENS=50
KB_BATCH_SIZE=32
KB_OCR_DPI=300
KB_HTTP_TIMEOUT=20
KB_MAX_DOWNLOAD_BYTES=60000000
KB_MAX_SOURCES=160
KB_THREADS=4

# Optional English-only local router. See docs/ENGLISH_ROUTER_RECOVERY.md.
JEV_ROUTING_MODE=off
# JEV_ARTIFACT_DIR=/absolute/path/to/evaluated/open-jev/english-v3
JEV_CPU_THREADS=2
JEV_TIMEOUT_SECONDS=10

# Bound essential SQLite contention and aggregate draft-cache payload storage.
CHECKPOINT_TIMEOUT_SECONDS=0.25
RAG_CACHE_MAX_BYTES=67108864
