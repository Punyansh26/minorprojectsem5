# Copy this file to .env and adjust as needed. All values shown are the defaults.

STT_SAMPLE_RATE=16000

# Model: tiny.en < base.en < small.en < medium.en < large-v3
# small.en is the sweet spot for CPU laptops. Use large-v3 only if you have a GPU.
STT_MODEL_SIZE=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_FINAL_BEAM_SIZE=5
STT_LANGUAGE=hne

STT_VAD_THRESHOLD=0.5
STT_VAD_MIN_SILENCE_MS=100

STT_EOS_SILENCE_MS=600
STT_MAX_UTTERANCE_MS=20000
STT_PARTIAL_INTERVAL_MS=700
STT_MIN_SPEECH_MS_FOR_PARTIAL=300
STT_PARTIAL_WINDOW_MS=6000

# --- Streaming prefix commit (LocalAgreement-N, FutureWork chapter 03 §2.1) ---
# When enabled, PARTIAL events carry a stable, append-only `committed_text`
# (longest token prefix that agreed across the last N partials) plus the
# revisable `pending_text`. Off by default: existing clients that read `text`
# are unaffected. N=2 is the recommended T0 setting (less flicker vs latency).
STT_PREFIX_COMMIT_ENABLED=false
STT_PREFIX_COMMIT_N=2

# --- Semantic end-of-turn gating (FutureWork chapter 03 §3.2) ---
# Gate finalisation on a small audio turn-completion classifier
# (e.g. vedants254 voice-turn-detection ONNX, MIT) instead of a pure silence
# timer. Disabled by default. When disabled OR the model/onnxruntime are absent
# OR inference errors, it degrades gracefully to the silence endpoint below
# (EOU_MAX_SILENCE_MS), i.e. exactly the legacy behaviour.
STT_EOU_ENABLED=false
# Absolute path to the EOU ONNX weights (download separately; nothing is bundled).
STT_EOU_MODEL_PATH=
# Completion-probability threshold tau. Calibrate per language/traffic:
# higher = fewer false cuts but more end-of-turn delay.
STT_EOU_THRESHOLD=0.5
# Minimum trailing silence before the EOU model is consulted at all (ms).
STT_EOU_MIN_SILENCE_MS=300
# Safety cap (ms): finalise on this much silence regardless of the model.
# Defaults to STT_EOS_SILENCE_MS so endpointing is unchanged when EOU is off.
STT_EOU_MAX_SILENCE_MS=600

# Domain vocabulary hint — improves recognition of clinic-specific terms/names.
# Customize per deployment (see README "Domain vocabulary").
STT_INITIAL_PROMPT=Appointment booking call. Mentions of dentist, dental cleaning, root canal, filling, checkup, braces, extraction, insurance, morning, afternoon, evening, AM, PM, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday, reschedule, cancel.

STT_HOST=0.0.0.0
STT_PORT=8000
STT_LOG_LEVEL=INFO
STT_ASR_WORKER_THREADS=4

# --- Production hardening (see README "Deploying for a real clinic") ---
# Leave STT_API_KEY blank for local dev only. ALWAYS set it before this is reachable off localhost.
STT_API_KEY=
STT_MAX_CONCURRENT_SESSIONS=8
STT_IDLE_TIMEOUT_S=30

# If you see "keepalive ping timeout" / WinError 64 disconnects on a slower CPU, these are
# already generous — you likely want STT_PARTIAL_INTERVAL_MS raised instead (see above), or
# a smaller model (STT_MODEL_SIZE=base.en or tiny.en).
STT_WS_PING_INTERVAL_S=20
STT_WS_PING_TIMEOUT_S=60

# MMS precision: float32 (research default), float16, or bfloat16 on CUDA.
# CPU always uses float32. Whisper still uses STT_COMPUTE_TYPE.
STT_MMS_DTYPE=float32
